{
  "manifest_version": 3,
  "name": "LinkedIn Recruiter Intelligence",
  "version": "0.9.0",
  "description": "n8n-driven LinkedIn recruiter scraper. Auto-pulls URLs from your n8n workflow, scrapes profiles + hiring posts, posts results back automatically.",

  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "notifications",
    "alarms"
  ],

  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://linkedin.com/*",
    "https://n8n.emergeautomation.tech/*",
    "https://*.n8n.cloud/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkedIn Recruiter Intelligence",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/in/*",
        "https://linkedin.com/in/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["popup.html", "job-scraper.js"],
      "matches": ["https://*.linkedin.com/*"]
    }
  ]
}
